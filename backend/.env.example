# Backend Environment Configuration Template
PROJECT_NAME="LeadDesk Mini API"
VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database Configuration (SQLAlchemy 2.x)
# PostgreSQL Example: postgresql+psycopg://user:password@localhost:5432/leaddesk_db
DATABASE_URL="sqlite:///./leaddesk.db"

# Security & JWT Configuration
SECRET_KEY="dev-secret-key-change-in-production-min-32-chars-long!"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server Host & Port Configuration
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# CORS Allowed Origins (JSON array format or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

